{
  "name": "full-windowed-youtube-ext",
  "version": "0.1.1",
  "description": "Expand YouTube videos to fill the browser window without entering fullscreen mode.",
  "author": "Vitalii Balabanov",
  "repository": "https://github.com/Tertiumnon/youtube-full-window-ext.git",
  "homepage": "https://github.com/Tertiumnon/youtube-full-window-ext#readme",
  "bugs": "https://github.com/Tertiumnon/youtube-full-window-ext/issues",
  "keywords": [
    "youtube",
    "firefox",
    "browser-extension",
    "windowed-fullscreen"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run --parallel watch firefox",
    "watch": "bun build.ts --watch",
    "firefox": "web-ext run",
    "start": "bun run build && bun run firefox",
    "build": "bun build.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons": "bun scripts/generate-icons.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "typecheck": "bun run check",
    "lint": "bun run build && web-ext lint --warnings-as-errors",
    "validate": "bun run check && bun test && bun run lint",
    "package": "bun run validate && web-ext build --overwrite-dest",
    "sign": "bun run validate && web-ext sign --channel=unlisted",
    "publish": "bun run validate && web-ext sign --channel=listed",
    "hooks:install": "bun node_modules/@tertium/js/scripts/git-hooks/git-hooks.ts",
    "changelog": "npx @tertium/gith changelog",
    "preversion": "bun run validate",
    "version": "bun scripts/sync-version.ts && npx @tertium/gith changelog --no-commit && git add src/manifest.json CHANGELOG.md",
    "release:patch": "npx @tertium/gith release --patch",
    "release:minor": "npx @tertium/gith release --minor",
    "release:major": "npx @tertium/gith release --major",
    "prepare": "bun scripts/prepare.ts"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tertium/js": "4.0.0",
    "@types/bun": "^1.4.2",
    "happy-dom": "latest",
    "typescript": "latest",
    "web-ext": "10.7.0"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5"
  }
}
